    },
    {
     "key": "mako-lf9-planung-c18",
     "front": "Was ist die AE-Provision?",
     "back": "Vergütung der Agentur durch die Medien (traditionell 15 % der Schaltkosten)."
    },
    {
     "key": "mako-lf9-planung-c19",
     "front": "Was ist ein Malstaffelrabatt?",
     "back": "Rabatt nach der Häufigkeit der Schaltungen."
