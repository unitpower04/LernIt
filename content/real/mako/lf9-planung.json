     "front": "Was ist ein Mengenrabatt in der Mediaplanung?",
     "back": "Nachlass nach Schaltvolumen (z. B. mm oder Seiten)."
    },
    {
     "key": "mako-lf9-planung-c21",
     "front": "Was ist DOOH?",
     "back": "Digital Out of Home – digitale Außenwerbung."
    },
    {
     "key": "mako-lf9-planung-c22",
     "front": "Was ist Programmatic Advertising?",
     "back": "Automatisierter, datengestützter Einkauf digitaler Werbeplätze in Echtzeit."
    },
    {
     "key": "mako-lf9-planung-c23",
     "front": "Was ist ein Mediaplan?",
     "back": "Detaillierte Übersicht von Medien, Terminen, Kosten und Kennziffern."
    }
