    {
     "key": "mako-lf9-planung-c08",
     "front": "Nenne Etatfindungsmethoden.",
     "back": "Prozent vom Umsatz/Gewinn, Konkurrenzorientierung, Verfügbarkeit, Ziel-/Aufgabenmethode, Pro-Kopf."
