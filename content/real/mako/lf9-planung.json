    {
     "key": "mako-lf9-planung-c13",
     "front": "Vorteile von Zeitschriften?",
     "back": "Zielgruppennähe, Qualität, lange Nutzung."
    },
    {
     "key": "mako-lf9-planung-c14",
     "front": "Vorteile von Zeitungen?",
     "back": "Aktualität, regionale Streuung."
    },
    {
