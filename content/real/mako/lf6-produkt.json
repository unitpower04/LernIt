    {
     "key": "mako-lf6-produkt-c01",
     "front": "Was ist Produktinnovation?",
     "back": "Einführung eines völlig neuen Produkts."
    },
    {
     "key": "mako-lf6-produkt-c02",
     "front": "Was ist Produktvariation?",
     "back": "Veränderung eines bestehenden Produkts (Design, Qualität, Verpackung)."
    },
    {
     "key": "mako-lf6-produkt-c03",
     "front": "Was ist Produktdifferenzierung?",
     "back": "Ergänzung des Produkts um Varianten (Größen, Sorten)."
    },
    {
     "key": "mako-lf6-produkt-c04",
     "front": "Was ist Produktelimination?",
     "back": "Herausnahme erfolgloser Produkte aus dem Sortiment."
    },
    {
     "key": "mako-lf6-produkt-c05",
     "front": "Was beschreibt die Sortimentsbreite?",
     "back": "Anzahl der verschiedenen Produktlinien."
    },
    {
     "key": "mako-lf6-produkt-c06",
     "front": "Was beschreibt die Sortimentstiefe?",
     "back": "Anzahl der Varianten innerhalb einer Produktlinie."
    },
    {
     "key": "mako-lf6-produkt-c07",
     "front": "Funktionen der Verpackung?",
     "back": "Schutz-, Lager-/Transport-, Verkaufs-, Informations- und Werbefunktion."
    },
    {
     "key": "mako-lf6-produkt-c08",
     "front": "Was ist eine Marke?",
     "back": "Kennzeichen, das Produkte unterscheidbar macht (Name, Logo, Klang, Farbe)."
    },
    {
     "key": "mako-lf6-produkt-c09",
     "front": "Was ist eine Einzelmarkenstrategie?",
     "back": "Jedes Produkt hat eine eigene Marke."
    },
    {
     "key": "mako-lf6-produkt-c10",
     "front": "Was ist eine Familienmarkenstrategie?",
     "back": "Mehrere Produkte tragen dieselbe Marke."
    },
    {
     "key": "mako-lf6-produkt-c11",
     "front": "Was ist eine Dachmarkenstrategie?",
     "back": "Alle Produkte werden unter dem Unternehmensnamen vermarktet."
    },
    {
     "key": "mako-lf6-produkt-c12",
     "front": "Was ist eine Mehrmarkenstrategie?",
     "back": "Ein Unternehmen führt mehrere Marken im selben Produktsegment."
    },
    {
     "key": "mako-lf6-produkt-c13",
     "front": "Was ist eine Handelsmarke?",
     "back": "Marke des Händlers (Eigenmarke) statt des Herstellers."
    },
    {
     "key": "mako-lf6-produkt-c14",
     "front": "Was ist Markentransfer?",
     "back": "Übertragung einer erfolgreichen Marke auf neue Produkte."
    },
    {
     "key": "mako-lf6-produkt-c15",
     "front": "Grundnutzen vs. Zusatznutzen?",
     "back": "Grundnutzen: Funktion. Zusatznutzen: Prestige, Design, Service, Emotion."
    },
    {
     "key": "mako-lf6-produkt-c16",
     "front": "Was ist der Markenkern?",
     "back": "Zentrale Werte und Versprechen der Marke."
    },
    {
     "key": "mako-lf6-produkt-c17",
     "front": "Nenne Maßnahmen in der Einführungsphase.",
     "back": "Hohe Werbung, Bekanntheit aufbauen, Distribution aufbauen."
    },
    {
     "key": "mako-lf6-produkt-c18",
     "front": "Nenne Maßnahmen in der Rückgangsphase.",
     "back": "Produktelimination oder Relaunch prüfen, Kosten senken."
    }
