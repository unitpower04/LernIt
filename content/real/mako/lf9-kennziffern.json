   "topic": "mako-lf9-kennziffern",
   "flashcards": [
    {
     "key": "mako-lf9-kennziffern-c01",
     "front": "Druckauflage?",
     "back": "Gesamtzahl der gedruckten Exemplare ohne Fehldrucke."
    },
    {
     "key": "mako-lf9-kennziffern-c02",
     "front": "Tatsächlich verbreitete Auflage?",
     "back": "Druckauflage abzüglich Restexemplare, Archiv- und Belegexemplare, Remittenden – inkl. Freiexemplare."
    },
    {
     "key": "mako-lf9-kennziffern-c03",
     "front": "Verkaufte Auflage?",
     "back": "Nur gegen Entgelt verbreitete Exemplare (Abo und Einzelverkauf)."
    },
    {
     "key": "mako-lf9-kennziffern-c04",
     "front": "Leser pro Nummer (LpN)?",
     "back": "Personen, die eine durchschnittliche Ausgabe gelesen oder durchgeblättert haben."
    },
    {
     "key": "mako-lf9-kennziffern-c05",
     "front": "Leser pro Exemplar (LpE)?",
     "back": "Wie viele Personen durchschnittlich dasselbe Exemplar lesen."
    },
    {
     "key": "mako-lf9-kennziffern-c06",
     "front": "Reichweite?",
     "back": "Anteil/Zahl der Zielpersonen mit mindestens einem Kontakt."
    },
    {
     "key": "mako-lf9-kennziffern-c07",
     "front": "Bruttoreichweite?",
     "back": "Summe aller Kontakte inkl. Mehrfachkontakte."
    },
    {
     "key": "mako-lf9-kennziffern-c08",
     "front": "Nettoreichweite?",
     "back": "Erreichte Personen ohne Mehrfachzählung."
    },
    {
     "key": "mako-lf9-kennziffern-c09",
     "front": "Kumulierte Reichweite?",
     "back": "Wachsende Reichweite über mehrere Schaltungen/Wochen."
    },
    {
     "key": "mako-lf9-kennziffern-c10",
     "front": "Wirksame Reichweite?",
     "back": "Reichweite von Personen mit der zur Wirkung nötigen Kontaktzahl."
    },
    {
     "key": "mako-lf9-kennziffern-c11",
     "front": "Kontakte pro Nutzer?",
     "back": "BRW : NRW – durchschnittliche Zahl der Kontakte je erreichter Person."
    },
    {
     "key": "mako-lf9-kennziffern-c12",
     "front": "Was sind GRP?",
     "back": "Gross Rating Points: durchschnittliche Kontakte pro 100 Zielpersonen – Maß für Werbedruck."
    },
    {
     "key": "mako-lf9-kennziffern-c13",
     "front": "GRP berechnen?",
     "back": "Reichweite in % × durchschnittliche Kontakte (oder Summe der Brutto-Reichweiten in %)."
    },
    {
     "key": "mako-lf9-kennziffern-c14",
     "front": "Was ist Affinität?",
     "back": "Anteil der Zielgruppe an der Nutzerschaft eines Mediums – Streugenauigkeit."
    },
    {
     "key": "mako-lf9-kennziffern-c15",
     "front": "Affinitätsindex berechnen?",
     "back": "(Anteil ZG im Medium : Anteil ZG in der Grundgesamtheit) × 100."
    },
    {
     "key": "mako-lf9-kennziffern-c16",
     "front": "Was bedeutet Affinitätsindex 150?",
     "back": "Die Zielgruppe ist im Medium 50 % stärker vertreten als in der Bevölkerung."
    },
    {
     "key": "mako-lf9-kennziffern-c17",
     "front": "Interne Überschneidung?",
     "back": "Mehrfacherreichung derselben Personen durch mehrere Schaltungen im selben Medium."
    },
    {
     "key": "mako-lf9-kennziffern-c18",
     "front": "Externe Überschneidung?",
     "back": "Mehrfacherreichung derselben Personen durch verschiedene Medien."
    },
    {
     "key": "mako-lf9-kennziffern-c19",
     "front": "Formel 1000er-Seitenpreis?",
     "back": "Seitenpreis × 1.000 : (verbreitete) Auflage."
    },
    {
     "key": "mako-lf9-kennziffern-c20",
     "front": "Formel 1000er-Kontaktpreis?",
     "back": "Preis × 1.000 : Bruttoreichweite."
    },
    {
     "key": "mako-lf9-kennziffern-c21",
     "front": "Formel 1000er-Nutzerpreis?",
     "back": "Preis × 1.000 : Nettoreichweite."
    },
    {
     "key": "mako-lf9-kennziffern-c22",
     "front": "Intermedial vs. intramedial?",
     "back": "Inter: zwischen Gattungen (TV vs. Print). Intra: innerhalb einer Gattung (Spiegel vs. Stern)."
    },
    {
     "key": "mako-lf9-kennziffern-c23",
     "front": "Was ist ein Unique Visitor?",
     "back": "Nettoreichweite online: einzelner Nutzer, einmal gezählt."
    },
    {
     "key": "mako-lf9-kennziffern-c24",
     "front": "Was ist eine Page Impression?",
     "back": "Abruf einer Seite mit potenzieller Werbung."
    },
    {
     "key": "mako-lf9-kennziffern-c25",
     "front": "Was ist eine Ad Impression?",
     "back": "Tatsächliche Einblendung eines Werbemittels."
    },
    {
     "key": "mako-lf9-kennziffern-c26",
     "front": "Was ist die CTR?",
     "back": "Click-Through-Rate: Klicks geteilt durch Impressions mal 100."
    },
    {
     "key": "mako-lf9-kennziffern-c27",
     "front": "Was ist Retargeting?",
     "back": "Erneute Ansprache von Website-Besuchern auf anderen Seiten."
    },
    {
     "key": "mako-lf9-kennziffern-c28",
     "front": "Was ist Behavioural Targeting?",
     "back": "Auswahl der Werbung nach dem Nutzerverhalten (Cookies)."
    },
    {
     "key": "mako-lf9-kennziffern-c29",
     "front": "Was ist Geotargeting?",
     "back": "Ausspielung nach geografischem Standort (IP/GPS)."
    },
    {
     "key": "mako-lf9-kennziffern-c30",
     "front": "Paid, Owned, Earned Media?",
     "back": "Bezahlte Kanäle; eigene Kanäle; durch Nutzer verdiente Reichweite."
    }
   ],
