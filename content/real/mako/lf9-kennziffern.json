   "templates": [
    {
     "key": "mako-lf9-kennziffern-t01",
     "type": "calc",
     "exam_part": 3,
     "difficulty": 2,
     "source": "MaKo (Skripte Vaaßen/Kuhn, Unterricht, Prüfungsstil)",
     "vars": {
      "m": {
       "type": "pick",
       "options": [
        "Spiegel",
        "Stern",
        "Focus",
        "Brigitte",
        "Bunte"
       ]
      },
      "p": {
       "type": "int",
       "min": 20000,
       "max": 80000,
       "step": 1000
      },
      "a": {
       "type": "dec",
       "min": 0.4,
       "max": 1.6,
       "decimals": 1
      }
     },
     "body": {
      "prompt": "Eine 1/1-seitige Farbanzeige im Magazin „{m}“ kostet netto {p|eur}. Verbreitete Auflage {a} Mio. Stück. Berechnen Sie den 1000er-Seitenpreis.",
      "answer": "p*1000/(a*1000000)",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "1000er-Seitenpreis = Seitenpreis · 1.000 : Auflage",
       "= {p|eur} · 1.000 : ({a} Mio.) = {result|eur}"
      ]
     }
    },
    {
     "key": "mako-lf9-kennziffern-t02",
     "type": "calc",
     "exam_part": 3,
     "difficulty": 2,
     "source": "MaKo (Skripte Vaaßen/Kuhn, Unterricht, Prüfungsstil)",
     "vars": {
      "p": {
       "type": "int",
       "min": 20000,
       "max": 80000,
       "step": 1000
      },
      "brw": {
       "type": "dec",
       "min": 3,
       "max": 8,
       "decimals": 2
      }
     },
     "body": {
      "prompt": "Eine Anzeige kostet {p|eur}. Das Medium erreicht {brw} Mio. Kontakte (Bruttoreichweite). Berechnen Sie den Tausender-Kontaktpreis.",
      "answer": "p*1000/(brw*1000000)",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "TKP = Preis · 1.000 : BRW = {result|eur}"
      ]
     }
    },
    {
     "key": "mako-lf9-kennziffern-t03",
     "type": "calc",
     "exam_part": 3,
     "difficulty": 2,
     "source": "MaKo (Skripte Vaaßen/Kuhn, Unterricht, Prüfungsstil)",
     "vars": {
      "p": {
       "type": "int",
       "min": 20000,
       "max": 80000,
       "step": 1000
      },
      "brw": {
       "type": "dec",
       "min": 5,
       "max": 8,
       "decimals": 2
      },
      "mk": {
       "type": "dec",
       "min": 0.5,
       "max": 1.5,
       "decimals": 2
      }
     },
     "body": {
      "prompt": "Eine Anzeige kostet {p|eur}. Bruttoreichweite {brw} Mio., davon {mk} Mio. Mehrfachkontakte. Berechnen Sie den Tausender-Nutzerpreis (bezogen auf die Nettoreichweite).",
      "answer": "p*1000/((brw-mk)*1000000)",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "Nettoreichweite = BRW − Mehrfachkontakte",
       "TNP = Preis · 1.000 : NRW = {result|eur}"
      ]
     }
