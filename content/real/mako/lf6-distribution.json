    {
     "key": "mako-lf6-distribution-c01",
     "front": "Direkter vs. indirekter Absatz?",
     "back": "Direkt: Hersteller verkauft selbst an Endkunden. Indirekt: über Handelsstufen."
    },
    {
     "key": "mako-lf6-distribution-c02",
     "front": "Beispiele direkter Absatzwege?",
     "back": "Eigener Onlineshop, Fabrikverkauf, Außendienst, Direktvertrieb."
    },
    {
     "key": "mako-lf6-distribution-c03",
     "front": "Beispiele indirekter Absatzwege?",
     "back": "Großhandel, Einzelhandel, Handelsvertreter, Kommissionär."
    },
    {
     "key": "mako-lf6-distribution-c04",
     "front": "Was ist ein Handelsvertreter?",
     "back": "Selbstständiger Vermittler im fremden Namen und auf fremde Rechnung; erhält Provision."
    },
    {
     "key": "mako-lf6-distribution-c05",
     "front": "Was ist ein Kommissionär?",
     "back": "Verkauft im eigenen Namen für fremde Rechnung."
    },
    {
     "key": "mako-lf6-distribution-c06",
     "front": "Was ist ein Makler?",
     "back": "Vermittelt Geschäftsabschlüsse, ohne ständig beauftragt zu sein."
    },
    {
     "key": "mako-lf6-distribution-c07",
     "front": "Was ist ein Reisender (Handlungsreisender)?",
     "back": "Angestellter Außendienstmitarbeiter mit Gehalt (ggf. plus Provision)."
    },
    {
     "key": "mako-lf6-distribution-c08",
     "front": "Was ist Franchising?",
     "back": "Franchisegeber überlässt gegen Gebühr Konzept, Marke und Know-how an selbstständige Franchisenehmer."
    },
    {
     "key": "mako-lf6-distribution-c09",
     "front": "Was ist intensive Distribution?",
     "back": "Das Produkt ist an möglichst vielen Verkaufsstellen erhältlich."
    },
    {
     "key": "mako-lf6-distribution-c10",
     "front": "Was ist selektive Distribution?",
     "back": "Nur ausgewählte Händler führen das Produkt."
    },
    {
     "key": "mako-lf6-distribution-c11",
     "front": "Was ist exklusive Distribution?",
     "back": "Nur ein Händler pro Gebiet führt das Produkt (Luxusgüter)."
    },
    {
     "key": "mako-lf6-distribution-c12",
     "front": "Was bedeutet Multi-Channel?",
     "back": "Verkauf über mehrere Kanäle (stationär, online, App)."
    },
    {
     "key": "mako-lf6-distribution-c13",
     "front": "Was ist Omni-Channel?",
     "back": "Nahtlose Verknüpfung aller Kanäle für ein einheitliches Kundenerlebnis."
    },
    {
     "key": "mako-lf6-distribution-c14",
     "front": "Was ist Just-in-Time?",
     "back": "Lieferung genau zum Bedarfszeitpunkt – geringe Lagerhaltung."
    }
   ],
