    {
     "key": "mako-lf7-konzept-c01",
     "front": "Aufbau eines Kommunikationskonzepts?",
     "back": "Ausgangslage, Ziele, Zielgruppe, Strategie/Botschaft, Instrumente/Maßnahmen, Budget/Zeitplan, Erfolgskontrolle."
    },
    {
     "key": "mako-lf7-konzept-c02",
     "front": "Ökonomische vs. außerökonomische Ziele?",
     "back": "Ökonomisch: Umsatz, Marktanteil, Gewinn. Außerökonomisch: Bekanntheit, Image, Einstellung."
    },
    {
     "key": "mako-lf7-konzept-c03",
     "front": "Was ist ein psychologisches Kommunikationsziel?",
     "back": "Z. B. Bekanntheit steigern, Image verbessern, Kaufabsicht fördern."
    },
    {
     "key": "mako-lf7-konzept-c04",
     "front": "Was bedeutet AIDA?",
     "back": "Attention, Interest, Desire, Action."
    },
    {
     "key": "mako-lf7-konzept-c05",
     "front": "Was ist die Kernbotschaft?",
     "back": "Die zentrale Aussage, die die Zielgruppe verstehen und behalten soll."
    },
    {
     "key": "mako-lf7-konzept-c06",
     "front": "Was ist ein Claim?",
     "back": "Kurzer Markenspruch, der das Versprechen der Marke zusammenfasst."
    },
    {
     "key": "mako-lf7-konzept-c07",
     "front": "Was ist ein Key Visual?",
     "back": "Zentrales Leitbild einer Kampagne mit hohem Wiedererkennungswert."
    },
    {
     "key": "mako-lf7-konzept-c08",
     "front": "Was beinhaltet die Copy Strategy?",
     "back": "Consumer Benefit, Reason Why, Tonality."
    },
    {
     "key": "mako-lf7-konzept-c09",
     "front": "Was ist der Consumer Benefit?",
     "back": "Der Nutzen, den die Zielgruppe vom Produkt hat."
    },
    {
     "key": "mako-lf7-konzept-c10",
     "front": "Was ist Reason Why?",
     "back": "Die Begründung/Beweis für das Nutzenversprechen."
    },
    {
     "key": "mako-lf7-konzept-c11",
     "front": "Was ist Tonalität?",
     "back": "Der Ton der Kommunikation (humorvoll, seriös, jugendlich)."
    },
    {
     "key": "mako-lf7-konzept-c12",
     "front": "Was ist Storytelling?",
     "back": "Vermittlung der Botschaft in einer erzählenden Geschichte."
    },
    {
     "key": "mako-lf7-konzept-c13",
     "front": "Nenne Schlüsselreize.",
     "back": "Kindchenschema, Erotik, Humor, Überraschung."
    },
    {
     "key": "mako-lf7-konzept-c14",
     "front": "Was ist integrierte Kommunikation?",
     "back": "Alle Instrumente werden formal, inhaltlich und zeitlich aufeinander abgestimmt."
    },
    {
     "key": "mako-lf7-konzept-c15",
     "front": "Wie misst man Werbewirkung?",
     "back": "Recall/Recognition, Image-Tests, Klickraten, Umsatz."
    },
    {
     "key": "mako-lf7-konzept-c16",
     "front": "Was ist Recall?",
     "back": "Ungestützte Erinnerung an Werbung/Marke."
    },
    {
     "key": "mako-lf7-konzept-c17",
     "front": "Was ist Recognition?",
     "back": "Gestützte Wiedererkennung."
    },
    {
     "key": "mako-lf7-konzept-c18",
     "front": "Was ist ein Pre-Test?",
     "back": "Test von Werbemitteln vor dem Einsatz."
    },
    {
     "key": "mako-lf7-konzept-c19",
     "front": "Was ist ein KPI?",
     "back": "Key Performance Indicator – Kennzahl zur Erfolgsmessung."
