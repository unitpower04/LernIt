    {
     "key": "mako-lf4-marktforschung-c01",
     "front": "Primär- vs. Sekundärforschung?",
     "back": "Primär: neue Daten erheben. Sekundär: vorhandene Daten auswerten."
    },
    {
     "key": "mako-lf4-marktforschung-c02",
     "front": "Beispiele Sekundärforschung?",
     "back": "Internetrecherche, Statistiken, Fachpresse, Geschäftsberichte."
    },
    {
     "key": "mako-lf4-marktforschung-c03",
     "front": "Beispiele Primärforschung?",
     "back": "Befragung, Beobachtung, Experiment, Test, Gruppendiskussion."
    },
    {
     "key": "mako-lf4-marktforschung-c04",
     "front": "Was ist eine Panel-Befragung?",
     "back": "Wiederholte Befragung derselben Personen über einen längeren Zeitraum."
    },
    {
     "key": "mako-lf4-marktforschung-c05",
     "front": "Was ist eine Omnibus-Befragung?",
     "back": "Mehrthemenbefragung im Auftrag mehrerer Unternehmen."
    },
    {
     "key": "mako-lf4-marktforschung-c06",
     "front": "Was ist ein Testmarkt?",
     "back": "Räumlich begrenztes Gebiet, in dem ein Produkt vor der Einführung getestet wird."
    },
    {
     "key": "mako-lf4-marktforschung-c07",
     "front": "Quantitativ vs. qualitativ?",
     "back": "Quantitativ: Zahlen, große Stichprobe. Qualitativ: Motive/Meinungen, kleine Gruppen."
    },
    {
     "key": "mako-lf4-marktforschung-c08",
     "front": "Was bedeutet Repräsentativität?",
     "back": "Die Stichprobe bildet die Grundgesamtheit strukturgleich und verkleinert ab."
    },
    {
     "key": "mako-lf4-marktforschung-c09",
     "front": "Was bedeutet Validität?",
     "back": "Gültigkeit: Es wird gemessen, was gemessen werden soll."
    },
    {
     "key": "mako-lf4-marktforschung-c10",
     "front": "Was bedeutet Reliabilität?",
     "back": "Zuverlässigkeit: Bei Wiederholung ergeben sich gleiche Ergebnisse."
    },
    {
     "key": "mako-lf4-marktforschung-c11",
     "front": "Was bedeutet Signifikanz?",
     "back": "Das Ergebnis liegt über der Zufallswahrscheinlichkeit."
    },
    {
     "key": "mako-lf4-marktforschung-c12",
     "front": "Was ist das Quotaverfahren?",
     "back": "Interviewer wählt Personen nach vorgegebenen Merkmalen (z. B. Alter, Geschlecht) frei aus."
    },
    {
     "key": "mako-lf4-marktforschung-c13",
     "front": "Was ist Zufallsauswahl?",
     "back": "Jedes Element der Grundgesamtheit hat dieselbe Chance, gezogen zu werden."
    },
    {
     "key": "mako-lf4-marktforschung-c14",
     "front": "Was sind soziodemografische Merkmale?",
     "back": "Alter, Geschlecht, Einkommen, Bildung, Beruf, Haushaltsgröße."
    },
    {
     "key": "mako-lf4-marktforschung-c15",
     "front": "Was sind psychografische Merkmale?",
     "back": "Lebensstil, Werte, Einstellungen, Motive."
    },
    {
     "key": "mako-lf4-marktforschung-c16",
     "front": "Was sind verhaltensbezogene Merkmale?",
     "back": "Kaufverhalten, Markentreue, Einkaufsstättenwahl, Mediennutzung."
    },
    {
     "key": "mako-lf4-marktforschung-c17",
     "front": "Was ist ein Insight?",
     "back": "Ein tiefes Verständnis der (oft unausgesprochenen) Bedürfnisse einer Zielgruppe."
    },
    {
     "key": "mako-lf4-marktforschung-c18",
     "front": "Was ist eine Persona?",
     "back": "Fiktive, typische Vertreterin einer Zielgruppe mit Eigenschaften und Bedürfnissen."
    },
    {
     "key": "mako-lf4-marktforschung-c19",
     "front": "Was ist eine Konkurrenzanalyse?",
     "back": "Untersuchung von Wettbewerbern (Angebote, Preise, Kommunikation)."
    },
    {
     "key": "mako-lf4-marktforschung-c20",
     "front": "Was ist ein offenes Interview?",
     "back": "Flexibles Gespräch mit Leitfaden – hohe Flexibilität, aber aufwendige Auswertung."
    }
