    {
     "key": "mako-lf7-instrumente-c01",
     "front": "Was ist ATL, BTL, TTL?",
     "back": "ATL: klassische Mediawerbung. BTL: Verkaufsförderung, Direktmarketing, Events. TTL: integrierte Kombination."
    },
    {
     "key": "mako-lf7-instrumente-c02",
     "front": "Ziel der Verkaufsförderung?",
     "back": "Kurzfristige Umsatzsteigerung durch Kaufanreize."
    },
    {
     "key": "mako-lf7-instrumente-c03",
     "front": "Was ist Consumer Promotion?",
     "back": "VKF-Maßnahme für Endverbraucher (Gutschein, Gewinnspiel, Probierpackung)."
    },
    {
     "key": "mako-lf7-instrumente-c04",
     "front": "Was ist Trade Promotion?",
     "back": "VKF-Maßnahme für Handelspartner (Schulung, Displays, Naturalrabatt)."
    },
    {
     "key": "mako-lf7-instrumente-c05",
     "front": "Was ist Staff Promotion?",
     "back": "VKF-Maßnahme für eigene Mitarbeiter/Außendienst (Prämien, Wettbewerbe)."
    },
    {
     "key": "mako-lf7-instrumente-c06",
     "front": "Ziel der Public Relations?",
     "back": "Vertrauen und positives Image in der Öffentlichkeit aufbauen."
    },
    {
     "key": "mako-lf7-instrumente-c07",
     "front": "Nenne PR-Maßnahmen.",
     "back": "Pressemitteilung, Pressekonferenz, Tag der offenen Tür, Geschäftsbericht, Krisenkommunikation."
    },
    {
     "key": "mako-lf7-instrumente-c08",
     "front": "Was ist Sponsoring?",
     "back": "Förderung von Personen/Organisationen mit Geld oder Sachleistungen gegen Kommunikationsleistungen."
    },
    {
     "key": "mako-lf7-instrumente-c09",
     "front": "Sponsoringarten?",
     "back": "Sport-, Kultur-, Sozio-, Umwelt-, Mediensponsoring."
    },
    {
     "key": "mako-lf7-instrumente-c10",
     "front": "Was ist Eventmarketing?",
     "back": "Inszenierung von Erlebnissen, um Zielgruppen emotional zu binden."
    },
    {
     "key": "mako-lf7-instrumente-c11",
     "front": "Was sind Messen?",
     "back": "Branchenveranstaltungen zur Präsentation und Kontaktanbahnung (v. a. B2B)."
    },
    {
     "key": "mako-lf7-instrumente-c12",
     "front": "Was ist Direktmarketing?",
     "back": "Direkte, individuelle Ansprache einzelner Zielpersonen mit Reaktionsmöglichkeit."
    },
    {
     "key": "mako-lf7-instrumente-c13",
     "front": "Was ist SEO?",
     "back": "Suchmaschinenoptimierung – bessere organische Platzierung."
    },
    {
     "key": "mako-lf7-instrumente-c14",
     "front": "Was ist SEA?",
     "back": "Suchmaschinenwerbung – bezahlte Anzeigen in Suchergebnissen."
    },
    {
     "key": "mako-lf7-instrumente-c15",
     "front": "Was ist Product Placement?",
     "back": "Gezielte Platzierung von Marken/Produkten in Film, Serie, Video."
    },
    {
     "key": "mako-lf7-instrumente-c16",
     "front": "Was ist Ambush-Marketing?",
     "back": "Trittbrettfahren: Nutzung eines Events ohne offizielle Sponsorenrechte."
    },
    {
     "key": "mako-lf7-instrumente-c17",
     "front": "Welche Maßnahme empfiehlt sich bei Ziel kurzfristiger Umsatzsteigerung?",
     "back": "Consumer Promotion (Verkaufsförderung)."
    },
    {
     "key": "mako-lf7-instrumente-c18",
     "front": "Was ist Influencer-Marketing?",
     "back": "Werbung durch reichweitenstarke Social-Media-Persönlichkeiten."
    },
    {
     "key": "mako-lf7-instrumente-c19",
     "front": "Was ist Affiliate-Marketing?",
     "back": "Provisionsbasierte Partnerwerbung (Pay per Sale/Click)."
    },
    {
     "key": "mako-lf7-instrumente-c20",
     "front": "Was ist Content Marketing?",
     "back": "Nützliche Inhalte statt direkter Werbung, um Zielgruppen zu binden."
    }
