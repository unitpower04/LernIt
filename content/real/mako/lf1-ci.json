     "key": "mako-lf1-ci-c01",
     "front": "Was ist Corporate Identity?",
     "back": "Das Selbstbild und die einheitliche Selbstdarstellung eines Unternehmens."
    },
    {
     "key": "mako-lf1-ci-c02",
     "front": "Was ist ein Image?",
     "back": "Das Fremdbild: Wie Außenstehende das Unternehmen wahrnehmen."
    },
    {
     "key": "mako-lf1-ci-c03",
     "front": "Nenne die drei Bausteine der CI.",
     "back": "Corporate Design, Corporate Communications, Corporate Behaviour."
    },
    {
     "key": "mako-lf1-ci-c04",
     "front": "Was umfasst Corporate Design?",
     "back": "Logo, Farben, Schriften, Bildsprache, Layoutraster."
    },
    {
     "key": "mako-lf1-ci-c05",
     "front": "Was ist Corporate Communications?",
     "back": "Alle kommunikativen Auftritte nach innen und außen."
    },
    {
     "key": "mako-lf1-ci-c06",
     "front": "Was ist Corporate Behaviour?",
     "back": "Das Verhalten des Unternehmens und seiner Mitarbeiter gegenüber Stakeholdern."
    },
    {
     "key": "mako-lf1-ci-c07",
     "front": "Ziele der CI?",
     "back": "Wiedererkennung, Vertrauen, Abgrenzung, Identifikation."
    },
    {
     "key": "mako-lf1-ci-c08",
     "front": "Was macht der Kontakter?",
     "back": "Betreut den Kunden, nimmt Briefings entgegen und koordiniert Aufträge (Account Management)."
    },
    {
     "key": "mako-lf1-ci-c09",
     "front": "Was macht der Art Director?",
     "back": "Verantwortet die visuelle Gestaltung."
    },
    {
     "key": "mako-lf1-ci-c10",
     "front": "Was macht der Creative Director?",
     "back": "Leitet das Kreativteam und verantwortet die kreative Gesamtidee."
    },
    {
     "key": "mako-lf1-ci-c11",
     "front": "Was macht der Trafficer?",
     "back": "Überwacht Termine, Ablauf und Auftragsfluss in der Agentur."
    },
    {
     "key": "mako-lf1-ci-c12",
     "front": "Was macht der Mediaplaner?",
     "back": "Plant die Auswahl und Schaltung von Werbeträgern."
    },
    {
     "key": "mako-lf1-ci-c13",
     "front": "Was ist eine Full-Service-Agentur?",
     "back": "Bietet alle Leistungen von Strategie über Kreation bis Media und Produktion."
    },
    {
     "key": "mako-lf1-ci-c14",
     "front": "Was ist eine Spezialagentur?",
     "back": "Konzentriert sich auf ein Feld (z. B. PR, Digital, Media)."
    },
    {
     "key": "mako-lf1-ci-c15",
     "front": "Aufbauorganisation vs. Ablauforganisation?",
     "back": "Aufbau: Struktur (wer). Ablauf: Prozesse (wie und wann)."
    }
