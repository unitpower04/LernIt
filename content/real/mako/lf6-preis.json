   "templates": [
    {
     "key": "mako-lf6-preis-t01",
     "type": "calc",
     "exam_part": 1,
     "difficulty": 2,
     "source": "MaKo (Skripte Vaaßen/Kuhn, Unterricht, Prüfungsstil)",
     "vars": {
      "p": {
       "type": "int",
       "min": 10,
       "max": 80,
       "step": 2
      },
      "r": {
       "type": "pick",
       "options": [
        10,
        15,
        20,
        25
       ]
      },
      "s": {
       "type": "pick",
       "options": [
        2,
        3
       ]
      }
     },
     "body": {
      "prompt": "Ein Werbemittel kostet {p|eur} netto je Stück. Der Händler erhält {r} % Wiederverkäuferrabatt und zahlt innerhalb der Frist mit {s} % Skonto (auf den Zielpreis). Wie viel zahlt er je Stück?",
      "answer": "p*(1-r/100)*(1-s/100)",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "Zielpreis = {p|eur} · (1 − {r} %)",
       "Barpreis = Zielpreis · (1 − {s} %) = {result|eur}"
      ]
     }
    }
