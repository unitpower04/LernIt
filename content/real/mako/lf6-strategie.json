     "key": "mako-lf6-strategie-c12",
     "front": "Was ist ein Star im BCG-Portfolio?",
     "back": "Hohes Marktwachstum, hoher Marktanteil – investieren."
    },
    {
     "key": "mako-lf6-strategie-c13",
     "front": "Was ist eine Cash Cow?",
     "back": "Niedriges Wachstum, hoher Marktanteil – liefert Gewinne zur Finanzierung."
    },
    {
     "key": "mako-lf6-strategie-c14",
     "front": "Was ist ein Question Mark?",
     "back": "Hohes Wachstum, niedriger Marktanteil – selektiv investieren oder aufgeben."
    },
    {
     "key": "mako-lf6-strategie-c15",
     "front": "Was ist ein Poor Dog?",
     "back": "Niedriges Wachstum, niedriger Marktanteil – desinvestieren."
