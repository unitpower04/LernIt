     "key": "mako-lf6-strategie-c01",
     "front": "Was ist eine SWOT-Analyse?",
     "back": "Bewertung von Stärken, Schwächen (intern), Chancen und Risiken (extern)."
    },
    {
     "key": "mako-lf6-strategie-c02",
     "front": "Intern vs. extern in der SWOT?",
     "back": "Stärken/Schwächen sind intern, Chancen/Risiken extern."
    },
    {
     "key": "mako-lf6-strategie-c03",
     "front": "Was ist eine SO-Strategie?",
     "back": "Mit Stärken Chancen nutzen (Wachstumsstrategie)."
    },
    {
     "key": "mako-lf6-strategie-c04",
     "front": "Was ist eine WO-Strategie?",
     "back": "Schwächen abbauen, um Chancen zu nutzen."
    },
    {
     "key": "mako-lf6-strategie-c05",
     "front": "Was ist eine ST-Strategie?",
     "back": "Mit Stärken Risiken abwehren."
    },
    {
     "key": "mako-lf6-strategie-c06",
     "front": "Was ist eine WT-Strategie?",
     "back": "Schwächen und Risiken minimieren (Rückzug, Defensive)."
    },
    {
     "key": "mako-lf6-strategie-c07",
     "front": "Was ist die Ansoff-Matrix?",
     "back": "Wachstumsmatrix aus Produkten und Märkten (neu/bestehend)."
    },
    {
     "key": "mako-lf6-strategie-c08",
     "front": "Marktdurchdringung?",
     "back": "Bestehende Produkte in bestehenden Märkten stärker verkaufen."
    },
    {
     "key": "mako-lf6-strategie-c09",
     "front": "Marktentwicklung?",
     "back": "Bestehende Produkte in neuen Märkten anbieten."
    },
    {
     "key": "mako-lf6-strategie-c10",
     "front": "Produktentwicklung?",
     "back": "Neue Produkte für bestehende Märkte."
    },
