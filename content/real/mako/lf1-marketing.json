   "topic": "mako-lf1-marketing",
   "flashcards": [
    {
     "key": "mako-lf1-marketing-c01",
     "front": "Was ist Marketing?",
     "back": "Unternehmensfunktion und Führungskonzept, das alle Aktivitäten konsequent an den Bedürfnissen des Marktes ausrichtet."
    },
    {
     "key": "mako-lf1-marketing-c02",
     "front": "Nenne die 4 P des Marketing-Mix.",
     "back": "Product, Price, Place, Promotion."
    },
    {
     "key": "mako-lf1-marketing-c03",
     "front": "Nenne die zusätzlichen 3 P im Dienstleistungsmarketing.",
     "back": "People, Process, Physical Evidence."
    },
    {
     "key": "mako-lf1-marketing-c04",
     "front": "Was beschreibt die Produktpolitik?",
     "back": "Gestaltung von Qualität, Design, Verpackung, Sortiment und Marke."
    },
    {
     "key": "mako-lf1-marketing-c05",
     "front": "Was beschreibt die Kontrahierungspolitik?",
     "back": "Preise, Rabatte, Boni, Skonti, Zahlungs- und Lieferbedingungen."
    },
    {
     "key": "mako-lf1-marketing-c06",
     "front": "Was beschreibt die Distributionspolitik?",
     "back": "Wie und wo das Produkt zum Kunden gelangt (Absatzwege, Logistik, Standorte)."
    },
    {
     "key": "mako-lf1-marketing-c07",
     "front": "Was beschreibt die Kommunikationspolitik?",
     "back": "Alle Maßnahmen, mit denen Botschaften an Zielgruppen vermittelt werden."
    },
    {
     "key": "mako-lf1-marketing-c08",
     "front": "Warum müssen die Instrumente des Marketing-Mix abgestimmt sein?",
     "back": "Widersprüche (z. B. Premium-Preis bei schlechter Qualität) schaden dem Image."
    },
    {
     "key": "mako-lf1-marketing-c09",
     "front": "Was ist Dialogmarketing?",
     "back": "Kommunikation mit direkter Ansprache und Rückkanal (Mailing, Callcenter, E-Mail)."
    },
    {
     "key": "mako-lf1-marketing-c10",
     "front": "Was ist Guerilla-Marketing?",
     "back": "Unkonventionelle, überraschende Aktionen mit geringem Budget und großer Wirkung."
    },
    {
     "key": "mako-lf1-marketing-c11",
     "front": "Was ist Öko-Marketing?",
     "back": "Ausrichtung des Marketing an ökologischen Aspekten und Nachhaltigkeit."
    },
    {
     "key": "mako-lf1-marketing-c12",
     "front": "Was ist Eventmarketing?",
     "back": "Inszenierte Ereignisse, um Zielgruppen emotional zu erreichen (interne/öffentliche Events)."
    },
    {
     "key": "mako-lf1-marketing-c13",
     "front": "Was ist Ethno-Marketing?",
     "back": "Marketing für Zielgruppen mit besonderem kulturellem/sprachlichem Hintergrund."
    },
    {
     "key": "mako-lf1-marketing-c14",
     "front": "Was ist Content-Marketing?",
     "back": "Wertvolle Inhalte, die Zielgruppen anziehen und binden, statt direkter Werbung."
    },
    {
     "key": "mako-lf1-marketing-c15",
     "front": "Was ist Influencer-Marketing?",
     "back": "Zusammenarbeit mit reichweitenstarken Personen in sozialen Medien."
    },
    {
     "key": "mako-lf1-marketing-c16",
     "front": "Was ist ein Stakeholder?",
     "back": "Jede Gruppe mit Interesse am Unternehmen (Kunden, Mitarbeiter, Lieferanten, Öffentlichkeit)."
    }
   ],
