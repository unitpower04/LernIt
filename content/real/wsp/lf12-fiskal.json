    {
     "key": "wsp-lf12-fiskal-c01",
     "front": "Was ist Fiskalpolitik?",
     "back": "Steuerung der Wirtschaft durch Staatseinnahmen und -ausgaben."
    },
    {
     "key": "wsp-lf12-fiskal-c02",
     "front": "Was bedeutet antizyklisch?",
     "back": "Gegen die Konjunktur steuern: in der Rezession mehr ausgeben, im Boom sparen."
    },
    {
     "key": "wsp-lf12-fiskal-c03",
     "front": "Was tut der Staat in der Rezession?",
     "back": "Erhöht Ausgaben (Investitionen), senkt Steuern, nimmt notfalls Kredite auf."
    },
    {
     "key": "wsp-lf12-fiskal-c04",
     "front": "Was tut der Staat im Boom?",
     "back": "Senkt Ausgaben, erhöht Steuern, bildet Rücklagen/tilgt Schulden."
    },
    {
     "key": "wsp-lf12-fiskal-c05",
     "front": "Was ist eine prozyklische Politik?",
     "back": "Sie verstärkt die Konjunkturschwankungen."
    },
    {
     "key": "wsp-lf12-fiskal-c06",
     "front": "Was ist ein Konjunkturprogramm?",
     "back": "Zusätzliche Staatsausgaben, um die Nachfrage zu beleben."
    },
    {
     "key": "wsp-lf12-fiskal-c07",
     "front": "Nenne wichtige Steuern.",
     "back": "Einkommensteuer, Umsatzsteuer, Körperschaftsteuer, Gewerbesteuer, Energiesteuer."
    },
    {
     "key": "wsp-lf12-fiskal-c08",
     "front": "Was besagt die Schuldenbremse?",
     "back": "Der Bund darf strukturell nur 0,35 % des BIP an neuen Schulden machen."
    },
    {
     "key": "wsp-lf12-fiskal-c09",
     "front": "Maastricht-Kriterien zu Defizit und Schulden?",
     "back": "Defizit höchstens 3 % und Schuldenstand höchstens 60 % des BIP."
    },
    {
     "key": "wsp-lf12-fiskal-c10",
     "front": "Problem Time-Lag?",
     "back": "Zeitverzögerung zwischen Erkennen, Beschluss und Wirkung der Maßnahmen."
    },
    {
     "key": "wsp-lf12-fiskal-c11",
     "front": "Was ist Crowding-out?",
     "back": "Staatliche Kreditaufnahme verdrängt private Investitionen (Zinsanstieg)."
    },
    {
     "key": "wsp-lf12-fiskal-c12",
     "front": "Wer verfolgt Fiskalpolitik?",
     "back": "Bund, Länder und Gemeinden (Regierung/Parlament)."
    }
