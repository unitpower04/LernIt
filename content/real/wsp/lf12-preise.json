   "templates": [
    {
     "key": "wsp-lf12-preise-t01",
     "type": "calc",
     "exam_part": 2,
     "difficulty": 2,
     "source": "WSP LF12 VWL (Unterricht)",
     "vars": {
      "a": {
       "type": "pick",
       "options": [
        100,
        102,
        104,
        105,
        108,
        110
       ]
      },
      "b": {
       "type": "pick",
       "options": [
        112,
        114,
        115,
        118,
        120,
        125
       ]
      }
     },
     "body": {
      "prompt": "Der Preisindex stieg von {a} auf {b} Punkte. Berechnen Sie die Inflationsrate in Prozent.",
      "answer": "(b-a)/a*100",
      "unit": "%",
      "decimals": 2,
      "steps": [
       "Inflationsrate = ({b} − {a}) : {a} · 100",
       "= {result} %"
      ]
     }
    },
    {
     "key": "wsp-lf12-preise-t02",
     "type": "calc",
     "exam_part": 2,
     "difficulty": 2,
     "source": "WSP LF12 VWL (Unterricht)",
     "vars": {
      "p": {
       "type": "int",
       "min": 100,
       "max": 900,
       "step": 50
      },
      "i": {
       "type": "pick",
       "options": [
        2,
        3,
        4,
        5,
        8
       ]
      }
     },
     "body": {
      "prompt": "Ein Unternehmen verlangt für ein Paket {p|eur}. Bei einer Inflation von {i} % im Jahr: Wie viel würde das Paket im nächsten Jahr kosten (bei gleicher Preisentwicklung)?",
      "answer": "p*(1+i/100)",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "{p|eur} · (1 + {i} %) = {result|eur}"
      ]
     }
    }
