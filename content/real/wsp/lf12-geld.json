    {
     "key": "wsp-lf12-geld-c01",
     "front": "Oberstes Ziel der EZB?",
     "back": "Preisstabilität (mittelfristig 2 % Inflation)."
    },
    {
     "key": "wsp-lf12-geld-c02",
     "front": "Wo sitzt die EZB?",
     "back": "Frankfurt am Main."
    },
    {
     "key": "wsp-lf12-geld-c03",
     "front": "Nenne Instrumente der EZB.",
     "back": "Leitzinsen, Mindestreserve, Offenmarktgeschäfte, ständige Fazilitäten."
    },
    {
     "key": "wsp-lf12-geld-c04",
     "front": "Was ist der Hauptrefinanzierungssatz?",
     "back": "Zinssatz, zu dem sich Banken bei der EZB Geld leihen."
    },
    {
     "key": "wsp-lf12-geld-c05",
     "front": "Was ist die Einlagefazilität?",
     "back": "Banken können überschüssiges Geld über Nacht bei der EZB anlegen."
    },
    {
     "key": "wsp-lf12-geld-c06",
     "front": "Was ist die Mindestreserve?",
     "back": "Pflichtguthaben der Banken bei der Zentralbank (1 % der Einlagen)."
    },
    {
     "key": "wsp-lf12-geld-c07",
     "front": "Was sind Offenmarktgeschäfte?",
     "back": "Kauf/Verkauf von Wertpapieren durch die EZB zur Steuerung der Geldmenge."
    },
    {
     "key": "wsp-lf12-geld-c08",
     "front": "Was bewirkt eine Leitzinssenkung?",
     "back": "Kredite werden billiger → mehr Investition/Konsum → Konjunktur ↑, Inflation ↑ (expansiv)."
    },
    {
     "key": "wsp-lf12-geld-c09",
     "front": "Was bewirkt eine Leitzinserhöhung?",
     "back": "Kredite werden teurer → Nachfrage ↓ → Inflation ↓ (restriktiv)."
    },
    {
     "key": "wsp-lf12-geld-c10",
     "front": "Expansive Geldpolitik?",
     "back": "Geldmenge erhöhen, Zinsen senken – Konjunktur ankurbeln."
    },
    {
     "key": "wsp-lf12-geld-c11",
     "front": "Restriktive Geldpolitik?",
     "back": "Geldmenge verknappen, Zinsen erhöhen – Inflation bekämpfen."
    },
    {
     "key": "wsp-lf12-geld-c12",
     "front": "Was ist Giralgeld?",
     "back": "Buchgeld auf Konten; entsteht durch Kreditvergabe der Banken."
    },
    {
     "key": "wsp-lf12-geld-c13",
     "front": "Was umfasst die Geldmenge M1?",
     "back": "Bargeld und täglich fällige Einlagen."
    },
    {
     "key": "wsp-lf12-geld-c14",
     "front": "Was beschreibt die Quantitätsgleichung?",
     "back": "M · V = P · Y – Geldmenge mal Umlaufgeschwindigkeit = Preisniveau mal reales BIP."
    },
    {
     "key": "wsp-lf12-geld-c15",
     "front": "Was ist Quantitative Easing?",
     "back": "Massenhafter Ankauf von Anleihen durch die EZB, um Geld bereitzustellen und Zinsen zu senken."
    },
    {
     "key": "wsp-lf12-geld-c16",
     "front": "Ist die EZB weisungsgebunden?",
     "back": "Nein – sie ist unabhängig von nationalen Regierungen."
