    {
     "key": "wsp-lf12-kreislauf-c01",
     "front": "Nenne die Produktionsfaktoren.",
     "back": "Arbeit, Boden, Kapital (betriebswirtschaftlich auch Information/Wissen)."
    },
    {
     "key": "wsp-lf12-kreislauf-c02",
     "front": "Was erhalten Haushalte für den Einsatz der Produktionsfaktoren?",
     "back": "Einkommen: Lohn (Arbeit), Pacht/Miete (Boden), Zins (Kapital), Gewinn."
    },
    {
     "key": "wsp-lf12-kreislauf-c03",
     "front": "Geldstrom vs. Güterstrom?",
     "back": "Gegenläufig: Güter von Unternehmen zu Haushalten, Geld in umgekehrter Richtung."
    },
    {
     "key": "wsp-lf12-kreislauf-c04",
     "front": "Was ist eine Subvention?",
     "back": "Staatliche Zahlung an Unternehmen ohne direkte Gegenleistung."
    },
    {
     "key": "wsp-lf12-kreislauf-c05",
     "front": "Was ist eine Transferzahlung?",
     "back": "Staatliche Leistung an Haushalte ohne Gegenleistung (Kindergeld, Bürgergeld)."
    },
    {
     "key": "wsp-lf12-kreislauf-c06",
     "front": "Was entsteht durch Sparen im Kreislauf?",
     "back": "Ein Geldabfluss – die Banken stellen es als Kredit für Investitionen wieder bereit."
    },
    {
     "key": "wsp-lf12-kreislauf-c07",
     "front": "Gleichgewichtsbedingung im Kreislauf?",
     "back": "Ersparnis = Investition; Export = Import."
    },
    {
     "key": "wsp-lf12-kreislauf-c08",
     "front": "Was tut der Staat im erweiterten Kreislauf?",
     "back": "Erhebt Steuern, zahlt Subventionen und Transfers, kauft Güter und Dienstleistungen."
    },
    {
     "key": "wsp-lf12-kreislauf-c09",
     "front": "Was zeigt der Außenbeitrag?",
     "back": "Exporte minus Importe."
    },
    {
     "key": "wsp-lf12-kreislauf-c10",
     "front": "Was ist Investition?",
     "back": "Kauf von Maschinen, Gebäuden und Anlagen zur Produktion (Bruttoinvestition) – erhöht Produktionskapazität."
    }
   ],
