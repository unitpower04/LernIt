    {
     "key": "wsp-lf12-ordnung-c01",
     "front": "Was bedeutet Knappheit?",
     "back": "Die Güter reichen nicht aus, um alle Bedürfnisse zu befriedigen."
    },
    {
     "key": "wsp-lf12-ordnung-c02",
     "front": "Bedürfnis, Bedarf, Nachfrage?",
     "back": "Bedürfnis = Wunsch; Bedarf = mit Kaufkraft unterlegtes Bedürfnis; Nachfrage = am Markt geäußerter Bedarf."
    },
    {
     "key": "wsp-lf12-ordnung-c03",
     "front": "Merkmale der freien Marktwirtschaft?",
     "back": "Privateigentum, Wettbewerb, Preisbildung durch Angebot und Nachfrage, Staat nur Ordnungsrahmen."
    },
    {
     "key": "wsp-lf12-ordnung-c04",
     "front": "Merkmale der Zentralverwaltungswirtschaft?",
     "back": "Planbehörde bestimmt Produktion und Preise; Kollektiveigentum."
    },
    {
     "key": "wsp-lf12-ordnung-c05",
     "front": "Nachteil der Zentralverwaltungswirtschaft?",
     "back": "Wenig Leistungsanreiz, Fehlallokation, Mangel, kaum Konsumentenfreiheit."
    },
    {
     "key": "wsp-lf12-ordnung-c06",
     "front": "Nachteil der freien Marktwirtschaft?",
     "back": "Soziale Ungleichheit, Konzentration/Monopole, Externe Effekte ohne Eingriff."
    },
    {
     "key": "wsp-lf12-ordnung-c07",
     "front": "Was ist die soziale Marktwirtschaft?",
     "back": "Marktwirtschaft mit sozialem Ausgleich durch den Staat."
    },
    {
     "key": "wsp-lf12-ordnung-c08",
     "front": "Beispiele sozialer Ausgleich?",
     "back": "Sozialversicherung, Kündigungsschutz, Kartellrecht, Mindestlohn, Wohngeld, Verbraucherschutz."
    },
    {
     "key": "wsp-lf12-ordnung-c09",
     "front": "Wer prägte die soziale Marktwirtschaft?",
     "back": "Alfred Müller-Armack und Ludwig Erhard."
    },
    {
     "key": "wsp-lf12-ordnung-c10",
     "front": "Was ist der primäre Sektor?",
     "back": "Urproduktion: Land-/Forstwirtschaft, Fischerei, Bergbau."
    },
    {
     "key": "wsp-lf12-ordnung-c11",
     "front": "Was ist der sekundäre Sektor?",
     "back": "Industrie und Handwerk – Weiterverarbeitung."
    },
    {
     "key": "wsp-lf12-ordnung-c12",
     "front": "Was ist der tertiäre Sektor?",
     "back": "Dienstleistungen (Handel, Banken, Werbeagenturen)."
    },
    {
     "key": "wsp-lf12-ordnung-c13",
     "front": "Nenne die Wirtschaftssubjekte.",
     "back": "Private Haushalte, Unternehmen, Staat, Ausland."
    },
    {
     "key": "wsp-lf12-ordnung-c14",
     "front": "Was ist ein Wirtschaftsgut?",
     "back": "Knappes Gut, das einen Preis hat (im Gegensatz zu freien Gütern wie Luft)."
    },
    {
     "key": "wsp-lf12-ordnung-c15",
     "front": "Konsumgüter vs. Produktionsgüter?",
     "back": "Konsumgüter befriedigen direkt Bedürfnisse, Produktionsgüter dienen der Herstellung anderer Güter."
    }
