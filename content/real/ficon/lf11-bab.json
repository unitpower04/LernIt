     "front": "Wie berechnet man den internen Stundensatz?",
     "back": "Selbstkosten : abgerechnete Stunden."
    },
    {
     "key": "ficon-bab-c07",
     "front": "Wie berechnet man den externen Stundensatz?",
     "back": "Interner Stundensatz + Gewinnaufschlag (z. B. ×1,20)."
    },
    {
     "key": "ficon-bab-c08",
     "front": "Wie verteilt man Mietkosten auf Kostenstellen?",
     "back": "Nach den genutzten Quadratmetern."
    },
    {
     "key": "ficon-bab-c09",
     "front": "Verteilungsschlüssel Strom?",
     "back": "Nach kWh oder Anzahl Geräte/Arbeitsplätze."
    },
    {
     "key": "ficon-bab-c10",
     "front": "Reihenfolge der Kostenstellenrechnung?",
     "back": "Gemeinkostenarten übernehmen → verteilen → Gesamtkosten der Stellen → Zuschlagssätze."
    },
    {
     "key": "ficon-bab-c11",
     "front": "Was sind direkte Personalkosten?",
     "back": "Lohn-/Gehaltskosten, die direkt einem Auftrag zurechenbar sind (Einzelkosten)."
    },
    {
     "key": "ficon-bab-c12",
     "front": "Interner vs. externer Stundensatz?",
     "back": "Intern = Kosten je Stunde; extern = Verkaufspreis je Stunde inkl. Gewinn."
