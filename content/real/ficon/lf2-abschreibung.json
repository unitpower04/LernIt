   "templates": [
    {
     "key": "ficon-abschreibung-t01",
     "type": "calc",
     "exam_part": 3,
     "difficulty": 2,
     "source": "FiCon (Themenübersicht KMK, Unterricht)",
     "vars": {
      "obj": {
       "type": "pick",
       "options": [
        "Server",
        "Kamerasystem",
        "Großformatdrucker",
        "Dienstwagen"
       ]
      },
      "p": {
       "type": "int",
       "min": 6000,
       "max": 30000,
       "step": 1000
      },
      "m": {
       "type": "int",
       "min": 200,
       "max": 1000,
       "step": 100
      },
      "r": {
       "type": "int",
       "min": 100,
       "max": 800,
       "step": 100
      },
      "n": {
       "type": "pick",
       "options": [
        3,
        4,
        5,
        6,
        8
       ]
      }
     },
     "body": {
      "prompt": "Eine Agentur kauft einen {obj} für {p|eur} netto. Die Montage kostet {m|eur}, ein Rabatt von {r|eur} wird gewährt. Nutzungsdauer {n} Jahre, lineare Abschreibung. Wie hoch ist die jährliche Abschreibung?",
      "answer": "(p+m-r)/n",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "Anschaffungskosten = {p|eur} + {m|eur} − {r|eur}",
       "AfA = Anschaffungskosten : {n} = {result|eur}"
      ]
     }
    },
    {
     "key": "ficon-abschreibung-t02",
     "type": "calc",
     "exam_part": 3,
     "difficulty": 2,
     "source": "FiCon (Themenübersicht KMK, Unterricht)",
     "vars": {
      "ak": {
       "type": "int",
       "min": 6000,
       "max": 24000,
       "step": 1200
      },
      "n": {
       "type": "pick",
       "options": [
        3,
        4,
        5,
        6
       ]
      },
      "mo": {
       "type": "int",
       "min": 2,
       "max": 11,
       "step": 1,
       "fmt": "raw"
      }
     },
     "body": {
      "prompt": "Ein Gerät mit Anschaffungskosten von {ak|eur} und einer Nutzungsdauer von {n} Jahren wird zum {mo}. (Monat Nr.) des Jahres angeschafft (Anschaffung am Monatsanfang). Wie hoch ist die anteilige Abschreibung im Anschaffungsjahr?",
      "answer": "ak/n*(13-mo)/12",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "Jahres-AfA = {ak|eur} : {n}",
       "anteilig = Jahres-AfA · (13 − {mo}) : 12 = {result|eur}"
      ]
     }
    },
    {
     "key": "ficon-abschreibung-t03",
     "type": "calc",
     "exam_part": 3,
     "difficulty": 2,
     "source": "FiCon (Themenübersicht KMK, Unterricht)",
     "vars": {
      "ak": {
       "type": "int",
       "min": 10000,
       "max": 40000,
       "step": 2000
      },
      "n": {
       "type": "pick",
       "options": [
        5,
        6,
        8
       ]
      },
      "j": {
       "type": "int",
       "min": 1,
       "max": 4,
       "step": 1,
       "fmt": "raw"
      }
     },
     "body": {
      "prompt": "Ein Fahrzeug (Anschaffungskosten {ak|eur}) wird {n} Jahre linear abgeschrieben. Wie hoch ist der Restbuchwert nach {j} Jahren?",
      "answer": "ak-ak/n*j",
      "unit": "€",
      "decimals": 2,
      "steps": [
       "AfA/Jahr = {ak|eur} : {n}",
       "Restbuchwert = {ak|eur} − {j} · AfA = {result|eur}"
      ]
     }
    }
