   "flashcards": [
    {
     "key": "ficon-jahresabschluss-c01",
     "front": "Was ist Inventur?",
     "back": "Die Bestandsaufnahme aller Vermögensteile und Schulden zu einem Stichtag nach Art, Menge und Wert."
    },
    {
     "key": "ficon-jahresabschluss-c02",
     "front": "Was ist ein Inventar?",
     "back": "Das ausführliche Bestandsverzeichnis: Vermögen − Schulden = Reinvermögen."
    },
    {
     "key": "ficon-jahresabschluss-c03",
     "front": "Wie berechnet sich das Reinvermögen?",
     "back": "Vermögen − Schulden."
    },
    {
     "key": "ficon-jahresabschluss-c04",
     "front": "Was ist die Bilanz?",
     "back": "Kurzgefasste Gegenüberstellung von Vermögen (Aktiva) und Kapital (Passiva) in T-Form."
    },
    {
     "key": "ficon-jahresabschluss-c05",
     "front": "Was zeigt die Aktivseite?",
     "back": "Die Mittelverwendung: Anlage- und Umlaufvermögen."
    },
    {
     "key": "ficon-jahresabschluss-c06",
     "front": "Was zeigt die Passivseite?",
     "back": "Die Mittelherkunft: Eigenkapital und Fremdkapital."
    },
    {
     "key": "ficon-jahresabschluss-c07",
     "front": "Nenne Beispiele für Anlagevermögen.",
     "back": "Gebäude, Fuhrpark, Maschinen, BGA, Software."
    },
    {
     "key": "ficon-jahresabschluss-c08",
     "front": "Nenne Beispiele für Umlaufvermögen.",
     "back": "Vorräte, Forderungen aLuL, Bankguthaben, Kasse."
    },
    {
     "key": "ficon-jahresabschluss-c09",
     "front": "Nenne Beispiele für Fremdkapital.",
     "back": "Darlehen, Verbindlichkeiten aLuL, Rückstellungen."
    },
    {
     "key": "ficon-jahresabschluss-c10",
     "front": "Was ist die GuV?",
     "back": "Gegenüberstellung von Erträgen und Aufwendungen eines Jahres; Saldo = Gewinn/Verlust."
    },
    {
     "key": "ficon-jahresabschluss-c11",
     "front": "Wie verändert ein Gewinn das Eigenkapital?",
     "back": "Gewinn erhöht, Verlust mindert das Eigenkapital."
    },
    {
     "key": "ficon-jahresabschluss-c12",
     "front": "Aufbewahrungsfrist Bilanzen und Bücher?",
     "back": "10 Jahre."
    },
    {
     "key": "ficon-jahresabschluss-c13",
     "front": "Aufbewahrungsfrist Handels-/Geschäftsbriefe?",
     "back": "6 Jahre."
    },
    {
     "key": "ficon-jahresabschluss-c14",
     "front": "Nenne Inventurarten.",
     "back": "Stichtagsinventur, ausgeweitete, vor-/nachverlegte, permanente Inventur, Stichprobeninventur."
    },
    {
     "key": "ficon-jahresabschluss-c15",
     "front": "Körperliche vs. buchmäßige Inventur?",
     "back": "Körperlich: zählen, messen, wiegen. Buchmäßig: Forderungen und Schulden per Belege/Saldenlisten."
    },
    {
     "key": "ficon-jahresabschluss-c16",
     "front": "Was bedeutet Bilanzsumme?",
     "back": "Summe der Aktiva = Summe der Passiva."
    },
    {
     "key": "ficon-jahresabschluss-c17",
     "front": "Was ist ein Bilanzgewinn?",
     "back": "Gewinn, der in der Bilanz als Eigenkapitalmehrung ausgewiesen wird."
    },
    {
     "key": "ficon-jahresabschluss-c18",
     "front": "Was bedeutet Mittelherkunft?",
     "back": "Woher das Kapital stammt (Eigen-/Fremdkapital)."
    },
    {
     "key": "ficon-jahresabschluss-c19",
     "front": "Was bedeutet Mittelverwendung?",
     "back": "Wofür das Kapital eingesetzt wurde (Vermögen)."
    }
   ],
