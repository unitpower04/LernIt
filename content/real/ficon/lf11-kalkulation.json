     "key": "ficon-kalkulation-c01",
     "front": "Aufbau Angebotskalkulation Agentur?",
     "back": "Agenturleistung (Std × Satz) + Fremdleistungen → Selbstkosten → + Gewinn/Handling Fee → Angebotspreis netto."
    },
    {
     "key": "ficon-kalkulation-c02",
     "front": "Was ist eine Handling Fee?",
     "back": "Aufschlag auf Fremdleistungen für Beschaffung/Abwicklung (z. B. 10 %)."
    },
    {
     "key": "ficon-kalkulation-c03",
     "front": "Was sind Fremdleistungen?",
     "back": "Leistungen Dritter (Foto, Druck, Mediabuchung), die die Agentur einkauft und weiterberechnet."
    },
    {
     "key": "ficon-kalkulation-c04",
     "front": "Wie wird ein Rabatt einkalkuliert?",
     "back": "Preis vor Rabatt = gewünschter Preis : (1 − Rabatt %)."
    },
    {
     "key": "ficon-kalkulation-c05",
     "front": "Was sind Selbstkosten?",
     "back": "Alle für den Auftrag entstehenden Kosten ohne Gewinn."
    },
    {
     "key": "ficon-kalkulation-c06",
     "front": "Wie wird der Angebotspreis brutto berechnet?",
     "back": "Netto-Angebotspreis · 1,19."
    },
    {
     "key": "ficon-kalkulation-c07",
     "front": "Was ist die Differenzkalkulation?",
     "back": "Vergleich Erlös − Selbstkosten, um den tatsächlichen Gewinn eines Auftrags zu prüfen."
    },
    {
     "key": "ficon-kalkulation-c08",
     "front": "Was kennzeichnet die Handelskalkulation?",
     "back": "Vom Einkaufspreis über Handlungskosten und Gewinn bis zum Listenverkaufspreis."
    },
    {
     "key": "ficon-kalkulation-c09",
     "front": "Barverkaufspreis → Zielverkaufspreis?",
     "back": "+ Kundenskonto (vom Hundert, im Zielverkaufspreis = 100 %)."
    },
    {
     "key": "ficon-kalkulation-c10",
     "front": "Zielverkaufspreis → Listenverkaufspreis?",
     "back": "+ Kundenrabatt (im Listenpreis = 100 %)."
    },
    {
     "key": "ficon-kalkulation-c11",
     "front": "Warum Gewinn nur auf Agenturleistung?",
     "back": "Fremdleistungen werden mit eigener Marge (Handling Fee) belegt."
    }
