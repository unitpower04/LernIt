   "topic": "deutsch-aa-bestandteile",
   "flashcards": [
    {
     "key": "deutsch-aa-bestandteile-c01",
     "front": "Nenne die Bestandteile einer Anzeige.",
     "back": "Headline, Subline, Bodycopy, Visual/Key Visual, Claim/Slogan, Logo, Call to Action, Packshot."
    },
    {
     "key": "deutsch-aa-bestandteile-c02",
     "front": "Aufgabe der Headline?",
     "back": "Aufmerksamkeit wecken und zum Weiterlesen anregen."
    },
    {
     "key": "deutsch-aa-bestandteile-c03",
     "front": "Was ist die Subline?",
     "back": "Ergänzende Zeile unter der Headline, die die Aussage präzisiert."
    },
    {
     "key": "deutsch-aa-bestandteile-c04",
     "front": "Was ist die Bodycopy?",
     "back": "Der Fließtext mit Argumenten und Informationen."
    },
    {
     "key": "deutsch-aa-bestandteile-c05",
     "front": "Was ist ein Visual/Key Visual?",
     "back": "Das zentrale Bild der Anzeige, das Aufmerksamkeit und Emotion erzeugt."
    },
    {
     "key": "deutsch-aa-bestandteile-c06",
     "front": "Was ist ein Claim?",
     "back": "Kurzer Markenspruch, der das Markenversprechen zusammenfasst."
    },
    {
     "key": "deutsch-aa-bestandteile-c07",
     "front": "Was ist ein Call to Action?",
     "back": "Aufforderung zu einer konkreten Handlung (z. B. „Jetzt testen“)."
    },
    {
     "key": "deutsch-aa-bestandteile-c08",
     "front": "Was ist ein Packshot?",
     "back": "Abbildung des Produkts in der Verpackung."
    },
    {
     "key": "deutsch-aa-bestandteile-c09",
     "front": "Was ist die Copy Strategy?",
     "back": "Textstrategie mit Consumer Benefit, Reason Why und Tonality – legt fest, was und wie kommuniziert wird."
    },
    {
     "key": "deutsch-aa-bestandteile-c10",
     "front": "Was ist der Consumer Benefit?",
     "back": "Das Nutzenversprechen an den Konsumenten."
    },
    {
     "key": "deutsch-aa-bestandteile-c11",
     "front": "Was ist der Reason Why?",
     "back": "Begründung oder Beweis, warum das Nutzenversprechen glaubwürdig ist."
    },
    {
     "key": "deutsch-aa-bestandteile-c12",
     "front": "Was ist die Tonality?",
     "back": "Die Tonlage der Kommunikation (z. B. witzig, seriös, emotional)."
    },
    {
     "key": "deutsch-aa-bestandteile-c13",
     "front": "Copy Strategy vs. Copy Analyse?",
     "back": "Strategie: Soll-Vorgabe vor der Gestaltung. Analyse: Untersuchung der fertigen Anzeige (Ist)."
    },
    {
     "key": "deutsch-aa-bestandteile-c14",
     "front": "Beispiele für Tonalities?",
     "back": "humorvoll, ironisch, emotional, sachlich-informativ, jugendlich, exklusiv."
    },
    {
     "key": "deutsch-aa-bestandteile-c15",
     "front": "Wofür wird ein Coupon/Response-Element genutzt?",
     "back": "Zur Messung der Reaktion und für Direktantworten."
    }
   ],
