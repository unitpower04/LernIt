    {
     "key": "deutsch-aa-gestaltung-c01",
     "front": "Wozu dient die Aktivierung?",
     "back": "Aufmerksamkeit der Zielgruppe wecken."
    },
    {
     "key": "deutsch-aa-gestaltung-c02",
     "front": "Was ist emotionale Aktivierung?",
     "back": "Ansprache über Gefühle (Humor, Erotik, Kindchenschema, Spannung)."
    },
    {
     "key": "deutsch-aa-gestaltung-c03",
     "front": "Was ist kognitive Aktivierung?",
     "back": "Ansprache des Denkens (Rätsel, Überraschung, Widerspruch, Information)."
    },
    {
     "key": "deutsch-aa-gestaltung-c04",
     "front": "Was ist physische Aktivierung?",
     "back": "Körperliche Reize wie Größe, Farbe, Kontrast, Lautstärke, Bewegung."
    },
    {
     "key": "deutsch-aa-gestaltung-c05",
     "front": "Was bedeutet Prägnanz?",
     "back": "Klare, einfache, schnell erfassbare Gestaltung."
    },
    {
     "key": "deutsch-aa-gestaltung-c06",
     "front": "Was ist Figur-Grund-Differenzierung?",
     "back": "Das Hauptelement hebt sich deutlich vom Hintergrund ab."
    },
    {
     "key": "deutsch-aa-gestaltung-c07",
     "front": "Worauf achtet man beim Einsatz von Farbe?",
     "back": "Signalwirkung, Kontrast, Corporate Colors, Lesbarkeit."
    },
    {
     "key": "deutsch-aa-gestaltung-c08",
     "front": "Worauf achtet man beim Einsatz von Schrift?",
     "back": "Lesbarkeit, Größenhierarchie, Schriftart, Zeilenlänge."
    },
    {
     "key": "deutsch-aa-gestaltung-c09",
     "front": "Was ist der Blickverlauf?",
     "back": "Die Reihenfolge, in der das Auge die Elemente erfasst (meist Bild – Headline – Text – Logo)."
    },
    {
     "key": "deutsch-aa-gestaltung-c10",
     "front": "Gestaltgesetz der Nähe?",
     "back": "Nahe beieinander liegende Elemente werden als zusammengehörig wahrgenommen."
    },
    {
     "key": "deutsch-aa-gestaltung-c11",
     "front": "Gestaltgesetz der Ähnlichkeit?",
     "back": "Elemente mit gleichen Merkmalen werden gruppiert."
    },
    {
     "key": "deutsch-aa-gestaltung-c12",
     "front": "Gestaltgesetz der Geschlossenheit?",
     "back": "Lücken in Formen werden gedanklich ergänzt."
    },
    {
     "key": "deutsch-aa-gestaltung-c13",
     "front": "Gestaltgesetz der Kontinuität?",
     "back": "Linien und Bewegungen werden gedanklich fortgesetzt."
    },
    {
     "key": "deutsch-aa-gestaltung-c14",
     "front": "Gestaltgesetz der Symmetrie?",
     "back": "Symmetrische Formen werden als zusammengehörige Einheit wahrgenommen."
    },
    {
     "key": "deutsch-aa-gestaltung-c15",
     "front": "Was ist ein Blickfänger?",
     "back": "Element, das als erstes die Aufmerksamkeit auf sich zieht."
    },
    {
     "key": "deutsch-aa-gestaltung-c16",
     "front": "Was ist das Kindchenschema?",
     "back": "Schlüsselreiz: kindliche Merkmale lösen positive Gefühle aus."
