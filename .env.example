# Öffentliche Supabase-Werte (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nur für `npm run content:import` (lokal, NIE committen oder in Vercel/Frontend setzen)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: KI-Bewertung offener Aufgaben (noch nicht aktiv)
ANTHROPIC_API_KEY=
